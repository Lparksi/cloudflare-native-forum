{
  "name": "cloudflare-native-forum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file db/seed.sql",
    "cf:types": "wrangler types --strict-vars false",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "auth:setup": "node scripts/setup-local-auth.mjs",
    "auth:schema": "auth generate --config ./scripts/auth-schema.config.ts --adapter drizzle --dialect sqlite --output ./src/db/auth-schema.ts --yes",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "notices:write": "node scripts/third-party-notices.mjs --write",
    "check:notices": "node scripts/third-party-notices.mjs",
    "license:prepare": "node scripts/license/prepare.mjs",
    "license:report": "node scripts/license/report.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/react": "^7.1.1",
    "@better-auth/drizzle-adapter": "1.7.13",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "better-auth": "1.7.13",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "1.7.13",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
