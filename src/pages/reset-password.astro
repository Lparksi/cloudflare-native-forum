---
import AuthLayout from '../layouts/AuthLayout.astro';
import AuthForm from '../components/AuthForm';
const token = Astro.url.searchParams.get('token') ?? undefined;
---

<AuthLayout title="重置密码">
  {!token || Astro.url.searchParams.has('error') ? (
    <p class="error">链接无效或已过期，请重新申请重置邮件。</p>
  ) : (
    <AuthForm mode="reset" token={token} client:load />
  )}
</AuthLayout>
