---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { repository } from '../db/repository';
const nodes = await repository(env.DB).nodes();
---

<Layout title="探索节点">
  <section class="intro">
    <div class="eyebrow">FIND YOUR CORNER</div>
    <h1>
      探索节点<span>。</span>
    </h1>
    <p>从一个兴趣出发，遇见不同的视角。</p>
  </section>
  <div class="node-grid">
    {nodes.map((node) => (
      <a class="panel padded node-card" href={`/go/${node.slug}`}>
        <h2>{node.name} ↗</h2>
        <p>{node.description}</p>
      </a>
    ))}
  </div>
</Layout>
