---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { localMailboxAllowed, localMessages } from '../../auth/mail';
if (!localMailboxAllowed(env, Astro.url.href))
  return new Response('Not Found', { status: 404 });
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const mail = await localMessages(env);
---

<Layout title="开发收件箱">
  <div class="narrow">
    <section class="panel padded">
      <h1>开发收件箱</h1>
      <p class="muted">
        仅供本机调试；包含敏感链接，不要分享或暴露此端口。仅显示最近 1 小时的 20
        封邮件。
      </p>
      <div class="mail-list">
        {mail.map((message) => (
          <article>
            <h2>{message.kind === 'verification' ? '验证邮箱' : '重置密码'}</h2>
            <p>{message.to}</p>
            <a class="text-link" href={message.url}>
              打开操作链接 →
            </a>
          </article>
        ))}
      </div>
      {mail.length === 0 && <p>暂无邮件。</p>}
    </section>
  </div>
</Layout>
