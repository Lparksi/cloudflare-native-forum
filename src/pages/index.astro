---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import TopicList from '../components/TopicList.astro';
import { repository } from '../db/repository';
import { parseFeed } from '../lib/contracts';
const repo = repository(env.DB);
import FeedControls from '../components/FeedControls.astro';
import FeedNavigation from '../components/FeedNavigation.astro';
let feed;
try {
  feed = parseFeed(Astro.url.searchParams);
} catch {
  return new Response('搜索、排序或分页参数无效', { status: 400 });
}
const [page, nodes] = await Promise.all([
  repo.list(feed.cursor, undefined, undefined, feed.options),
  repo.nodes(),
]);
---

<Layout>
  <h1 class="sr-only">社区讨论</h1>
  <div class="columns forum-home">
    <section class="panel discussion-panel" aria-label="讨论列表">
      <FeedNavigation options={feed.options} nodes={nodes} />
      <FeedControls options={feed.options} showSort={false} />
      <TopicList {...page} />
    </section>
    <aside aria-label="社区信息">
      <section class="panel welcome">
        <h2>0xca</h2>
        <p>关于开发、基础设施与创造的讨论空间。</p>
        <div class="sidebar-links">
          <a href="/new">分享一个想法 →</a>
          <a href="/about">了解社区</a>
        </div>
        <div class="local-badge">工程预览 · 本地数据</div>
      </section>
      <section class="panel node-panel">
        <div class="panel-heading">
          <h2>探索节点</h2>
          <a href="/nodes" class="muted">
            全部 →
          </a>
        </div>
        <div class="node-links">
          {nodes.map((node) => (
            <a href={`/go/${node.slug}`}>
              <span>{node.name}</span>
              <span class="muted">→</span>
            </a>
          ))}
        </div>
      </section>
      <p class="aside-note">保持好奇，认真表达，友善相待。</p>
    </aside>
  </div>
</Layout>
