{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-native-forum-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "send_email": [{ "name": "AUTH_EMAIL" }],
  "vars": {
    "APP_ENV": "local",
    "TURNSTILE_MODE": "local",
    "TURNSTILE_SITE_KEY": "",
    "TOPIC_RATE_LIMIT": "5",
    "REPLY_RATE_LIMIT": "20",
    "AUTH_MAIL_MODE": "local",
    "BETTER_AUTH_URL": "http://127.0.0.1:4321",
    "AUTH_MAIL_FROM": "noreply@example.invalid",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forum-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "db/migrations",
    },
  ],
  "env": {
    "test": {
      "name": "cloudflare-native-forum-test",
      "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET"] },
      "send_email": [{ "name": "AUTH_EMAIL" }],
      "vars": {
        "APP_ENV": "test",
        "TURNSTILE_MODE": "disabled",
        "TURNSTILE_SITE_KEY": "",
        "TOPIC_RATE_LIMIT": "5",
        "REPLY_RATE_LIMIT": "20",
        "AUTH_MAIL_MODE": "disabled",
        "BETTER_AUTH_URL": "https://test.example.invalid",
        "AUTH_MAIL_FROM": "noreply@example.invalid",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "forum-test",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "db/migrations",
        },
      ],
    },
    "production": {
      "name": "cloudflare-native-forum-production",
      "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET"] },
      "send_email": [{ "name": "AUTH_EMAIL" }],
      "vars": {
        "APP_ENV": "production",
        "TURNSTILE_MODE": "disabled",
        "TURNSTILE_SITE_KEY": "",
        "TOPIC_RATE_LIMIT": "5",
        "REPLY_RATE_LIMIT": "20",
        "AUTH_MAIL_MODE": "disabled",
        "BETTER_AUTH_URL": "https://forum.example.invalid",
        "AUTH_MAIL_FROM": "noreply@example.invalid",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "forum-production",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "db/migrations",
        },
      ],
    },
  },
}
